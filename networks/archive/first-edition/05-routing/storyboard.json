    {
      "id": "05-03",
      "title": "Add costs, not just hops",
      "chapter": "The routing puzzle",
      "duration": 21.166666666666668,
      "narration": "Consider A to B to D to F. Its cost is four plus five plus six, which equals fifteen. A longer path can cost less if its individual links are cheaper. Link cost might represent a configured preference; do not automatically interpret these numbers as milliseconds or available bandwidth.",
      "bullets": [
        "A-B-D-F costs 15",
        "Hop count is only one metric"
      ],
      "takeaway": "Path cost is the sum of the costs along that path.",
