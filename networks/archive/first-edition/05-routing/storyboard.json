    {
      "id": "05-02",
      "title": "Turn the network into a graph",
      "chapter": "The routing puzzle",
      "duration": 20.766666666666666,
      "narration": "Each circle represents a router, and each connecting line represents a usable link. The numbers are positive link costs in arbitrary units. Our teaching graph is undirected, so a link has the same cost in both directions. Real networks may have asymmetric costs, policies, and much larger topologies.",
      "bullets": [
        "Routers become vertices",
        "Links carry positive costs"
      ],
      "takeaway": "A graph makes route choices visible and calculable.",
